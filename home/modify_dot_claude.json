{{- /* chezmoi:modify-template */ -}}

{{- $mcpConfig := (include "claude-mcp-servers.json" | fromJson) -}}
{{- if ne .chezmoi.hostname "Plinth" -}}
{{-   $mcpConfig = ($mcpConfig | deleteValueAtPath "mcpServers.railway") -}}
{{- end -}}

{{- if .chezmoi.stdin }}
{{ fromJson .chezmoi.stdin | setValueAtPath "mcpServers" $mcpConfig.mcpServers | toPrettyJson }}
{{- end }}
