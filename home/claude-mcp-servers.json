{
  "mcpServers": {
    "dash-api": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Kapeli/dash-mcp-server.git",
        "dash-mcp-server"
      ]
    },
    "exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {}
    },
    "emacs": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${HOME}/src/github.com/jesse-c/emacs-mcp-server",
        "emacs-mcp-server"
      ]
    },
    "railway": {
      "command": "npx",
      "args": ["-y", "@railway/mcp-server"]
    }
  }
}
