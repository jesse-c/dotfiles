;;; my-tab-groups-tests.el --- Tests for tab group commands -*- lexical-binding: t; -*-

(require 'cl-lib)
(require 'ert)
(require 'tab-bar)
(require 'seq)
(require 'subr-x)

;; Read the actual definitions from init.el without running the rest of startup.
(let ((init-file (expand-file-name "../home/dot_config/emacs/init.el"
                                   (file-name-directory load-file-name))))
  (with-temp-buffer
    (insert-file-contents init-file)
    (goto-char (point-min))
    (search-forward "(use-package tab-bar")
    (goto-char (match-beginning 0))
    (let* ((form (read (current-buffer)))
           (config (cdr (memq :config form))))
      (dolist (definition config)
        (when (memq (car-safe definition) '(defun defcustom defconst))
          (eval definition t))))
    (goto-char (point-min))
    (dolist (name '(my/tab-bar-tab-buffers my/tab-bar-tab-awaiting-input-p))
      (search-forward (format "(defun %s " name))
      (goto-char (match-beginning 0))
      (eval (read (current-buffer)) t))))

(defvar my/agent-shell-awaiting-buffers nil)

(ert-deftest my-tab-groups/assign-delegates ()
  (let (called)
    (cl-letf (((symbol-function 'tab-bar-change-tab-group)
               (lambda (&rest args) (setq called args))))
      (my/tab-group-assign "Work" 3)
      (should (equal called '("Work" 3)))
      (my/tab-group-assign "" 2)
      (should (equal called '("" 2))))))

(ert-deftest my-tab-groups/assign-prompts-with-prefix ()
  (let (called prefix)
    (cl-letf (((symbol-function 'call-interactively)
               (lambda (command &rest _)
                 (setq called command prefix current-prefix-arg))))
      (my/tab-group-assign nil 3)
      (should (eq called 'tab-bar-change-tab-group))
      (should (= prefix 3)))))

(ert-deftest my-tab-groups/move-delegates ()
  (let (called)
    (cl-letf (((symbol-function 'tab-bar-move-tab-to-group)
               (lambda (tab) (setq called tab))))
      (let ((tab '(tab (group . "Work"))))
        (my/tab-group-move tab)
        (should (eq called tab))))))

(ert-deftest my-tab-groups/assign-and-move-targets-the-assigned-tab ()
  (let* ((current '(current-tab (name . "Current")))
         (target '(tab (name . "Target")))
         (tabs (list current target))
         (tab-bar-tabs-function (lambda () tabs))
         calls)
    (cl-letf (((symbol-function 'my/tab-group-assign)
               (lambda (&rest args) (push (cons 'assign args) calls)))
              ((symbol-function 'my/tab-group-move)
               (lambda (tab) (push (list 'move tab) calls))))
      (my/tab-group-assign-and-move "Work" 2)
      (should (equal (nreverse calls) (list '(assign "Work" 2) (list 'move target))))
      (setq calls nil)
      (my/tab-group-assign-and-move "Work")
      (should (equal (nreverse calls) (list '(assign "Work" nil) (list 'move current)))))))

(ert-deftest my-tab-groups/invalid-target-does-not-assign ()
  (let ((tab-bar-tabs-function (lambda () '((current-tab)))))
    (should-error (my/tab-group-assign-and-move "Work" 4) :type 'user-error)))

(ert-deftest my-tab-groups/stable-order-with-unassigned-first ()
  (let* ((a1 '(tab (name . "a1") (group . "A")))
         (u1 '(tab (name . "u1")))
         (b1 '(current-tab (name . "b1") (group . "B")))
         (a2 '(tab (name . "a2") (group . "A")))
         (u2 '(tab (name . "u2") (group)))
         (b2 '(tab (name . "b2") (group . "B")))
         (tabs (list a1 u1 b1 a2 u2 b2))
         (original (copy-sequence tabs))
         (ordered (my/tab-group--ordered-tabs tabs)))
    (should (equal ordered (list u1 u2 a1 a2 b1 b2)))
    (should (equal tabs original))
    (should (eq (nth 4 ordered) b1))
    (should (equal (my/tab-group--ordered-tabs ordered) ordered))))

(ert-deftest my-tab-groups/empty-and-single-group ()
  (should-not (my/tab-group--ordered-tabs nil))
  (dolist (tabs '(((current-tab) (tab))
                  ((current-tab (group . "A")) (tab (group . "A")))))
    (should (equal (my/tab-group--ordered-tabs tabs) tabs))))

(ert-deftest my-tab-groups/move-all-sets-tabs-without-selecting ()
  (let* ((current '(current-tab (group . "A")))
         (unassigned '(tab))
         (tab-bar-tabs-function (lambda () (list current unassigned)))
         result)
    (cl-letf (((symbol-function 'tab-bar-tabs-set)
               (lambda (tabs &optional _) (setq result tabs))))
      (my/tab-group-move-all)
      (should (equal result (list unassigned current)))
      (should (eq (cadr result) current)))))

(ert-deftest my-tab-groups/set-icon-preserves-other-groups-and-original-alist ()
  (let* ((original '(("Other" . "●")))
         (my/tab-group-icons original)
         (tab-bar-tabs-function (lambda () '((current-tab (group . "Work")))))
         saved)
    (cl-letf (((symbol-function 'char-displayable-p) (lambda (_) t))
              ((symbol-function 'customize-save-variable)
               (lambda (symbol value &rest _) (setq saved (list symbol value)))))
      (my/tab-group-set-icon "◇")
      (should (equal saved '(my/tab-group-icons (("Work" . "◇") ("Other" . "●")))))
      (should (equal original '(("Other" . "●")))))))

(ert-deftest my-tab-groups/set-icon-updates-and-clears ()
  (let ((my/tab-group-icons '(("Work" . "●") ("Other" . "◆"))))
    (cl-letf (((symbol-function 'char-displayable-p) (lambda (_) t))
              ((symbol-function 'customize-save-variable)
               (lambda (symbol value &rest _) (set symbol value))))
      (my/tab-group-set-icon "◇" "Work")
      (should (equal my/tab-group-icons '(("Work" . "◇") ("Other" . "◆"))))
      (my/tab-group-set-icon "" "Work")
      (should (equal my/tab-group-icons '(("Other" . "◆")))))))

(ert-deftest my-tab-groups/set-icon-requires-group ()
  (let ((tab-bar-tabs-function (lambda () '((current-tab)))))
    (should-error (my/tab-group-set-icon "◇") :type 'user-error)))

(ert-deftest my-tab-groups/set-icon-rejects-invalid-symbols-without-saving ()
  (cl-letf (((symbol-function 'char-displayable-p) (lambda (_) t))
            ((symbol-function 'customize-save-variable)
             (lambda (&rest _) (ert-fail "Invalid icon must not be saved"))))
    (dolist (icon '(nil "ab" "\n" "💼"))
      (should-error (my/tab-group-set-icon icon "Work") :type 'user-error))))

(ert-deftest my-tab-groups/icon-picker-filters-wide-symbols ()
  (let ((my/tab-group-icon-choices '(("Clear" . "") ("Diamond" . "◇") ("Emoji" . "💼")))
        (tab-bar-tabs-function (lambda () '((current-tab (group . "Work")))))
        offered saved)
    (cl-letf (((symbol-function 'char-displayable-p) (lambda (_) t))
              ((symbol-function 'completing-read)
               (lambda (_prompt choices &rest _) (setq offered choices) "Diamond"))
              ((symbol-function 'customize-save-variable)
               (lambda (_symbol value &rest _) (setq saved value))))
      (call-interactively #'my/tab-group-set-icon)
      (should (equal offered '(("Clear" . "") ("Diamond" . "◇"))))
      (should (equal saved '(("Work" . "◇")))))))

(ert-deftest my-tab-groups/set-icon-rejects-missing-glyph ()
  (cl-letf (((symbol-function 'char-displayable-p) (lambda (_) nil)))
    (should-error (my/tab-group-set-icon "◇" "Work") :type 'user-error)))

(ert-deftest my-tab-groups/formatter-keeps-hints-and-group-faces ()
  (let ((my/tab-group-icons '(("Work" . "◇")))
        (my/agent-shell-awaiting-buffers nil)
        (tab-bar-tab-hints t)
        (tab-bar-show-inactive-group-tabs nil)
        (tab '(tab (group . "Work"))))
    (let ((inactive (my/tab-group-format tab 3))
          (active (my/tab-group-format tab 3 t)))
      (should (equal (substring-no-properties inactive) "◇ 3 Work"))
      (should (equal (substring-no-properties active) "◇ Work"))
      (should (eq (get-text-property 0 'face inactive) 'tab-bar-tab-group-inactive))
      (should (eq (get-text-property 0 'face active) 'tab-bar-tab-group-current)))))

(ert-deftest my-tab-groups/formatter-without-icon-uses-built-in-label ()
  (let ((my/tab-group-icons nil)
        (my/agent-shell-awaiting-buffers nil))
    (should (equal (my/tab-group-format '(tab (group . "Work")) 1 t)
                   (tab-bar-tab-group-format-default '(tab (group . "Work")) 1 t)))))

(ert-deftest my-tab-groups/attention-in-hidden-member-highlights-whole-label ()
  (let* ((agent (generate-new-buffer " *tab-group-waiting-agent*"))
         (first '(tab (group . "Work")))
         (waiting '(tab (group . "Work")))
         (other '(current-tab (group . "Other")))
         (tab-bar-tabs-function (lambda () (list first waiting other)))
         (my/agent-shell-awaiting-buffers (list agent))
         (my/tab-group-icons '(("Work" . "◇"))))
    (unwind-protect
        (cl-letf (((symbol-function 'my/tab-bar-tab-buffers)
                   (lambda (tab) (when (eq tab waiting) (list (buffer-name agent))))))
          (should (my/tab-group-awaiting-input-p "Work"))
          (should-not (my/tab-group-awaiting-input-p "Other"))
          (should-not (my/tab-group-awaiting-input-p nil))
          (let ((label (my/tab-group-format first 1)))
            (should (memq 'my/tab-bar-tab-awaiting-input (get-text-property 0 'face label)))
            (should (memq 'my/tab-bar-tab-awaiting-input
                          (get-text-property (1- (length label)) 'face label))))
          (setq my/agent-shell-awaiting-buffers nil)
          (should-not (my/tab-group-awaiting-input-p "Work"))
          (should (eq (get-text-property 0 'face (my/tab-group-format first 1))
                      'tab-bar-tab-group-inactive)))
      (kill-buffer agent))))

(provide 'my-tab-groups-tests)
;;; my-tab-groups-tests.el ends here
